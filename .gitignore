# --- Testumgebung ---
# Die sshd-Testschluessel werden lokal erzeugt (tools\test-sshd\up.ps1). Private
# Schluessel gehoeren nie ins Repo, auch keine Wegwerf-Schluessel: sonst gewoehnt man
# sich daran, dass da welche liegen duerfen.
/tools/test-sshd/keys/

# --- Keystores und Secrets ---
# Breit gefasst: lieber eine harmlose Datei zu viel ausgeschlossen als ein
# privater Schluessel zu wenig. Wer hier etwas braucht, nimmt es bewusst mit -f auf.
