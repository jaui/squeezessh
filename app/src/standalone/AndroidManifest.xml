<?xml version="1.0" encoding="utf-8"?>
<!--
  Plugin-API der Variante "standalone".

  Authority und Permission-Namen unterscheiden diese Variante von der anderen. Beide
  gleichzeitig zu installieren ist unmoeglich: gleiche Provider-Authority fuehrt zu
  INSTALL_FAILED_CONFLICTING_PROVIDER, gleiche Permission-Namen zu DUPLICATE_PERMISSION.
  Diese Variante benutzt eigene Namen und laesst sich neben JuiceSSH installieren;
  bestehende Plugins finden sie aber nicht.

  Die Namen kommen aus `pluginApiAuthority` und `pluginApiPackage`, gesetzt in
  app/build.gradle.kts. Der Debug-Build bekommt dort ein `.debug` in den Namensraum —
  ohne das gehoerten die Permission-Namen geraeteweit dem zuerst installierten der beiden
  Builds, und der zweite liesse sich nicht danebenstellen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission-group
        android:name="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:description="@string/permission_group_plugin_api_description"
        android:label="@string/permission_group_plugin_api" />

    <permission
        android:name="${pluginApiAuthority}.permission.READ_CONNECTIONS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_read_connections_description"
        android:label="@string/permission_read_connections" />
    <permission
        android:name="${pluginApiAuthority}.permission.WRITE_CONNECTIONS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_write_connections_description"
        android:label="@string/permission_write_connections" />
    <permission
        android:name="${pluginApiAuthority}.permission.READ_CONNECTION_GROUPS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_read_connection_groups_description"
        android:label="@string/permission_read_connection_groups" />
    <permission
        android:name="${pluginApiAuthority}.permission.WRITE_CONNECTION_GROUPS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_write_connection_groups_description"
        android:label="@string/permission_write_connection_groups" />
    <permission
        android:name="${pluginApiAuthority}.permission.READ_PORT_FORWARDS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_read_port_forwards_description"
        android:label="@string/permission_read_port_forwards" />
    <permission
        android:name="${pluginApiAuthority}.permission.WRITE_PORT_FORWARDS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_write_port_forwards_description"
        android:label="@string/permission_write_port_forwards" />
    <permission
        android:name="${pluginApiAuthority}.permission.READ_SNIPPETS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_read_snippets_description"
        android:label="@string/permission_read_snippets" />
    <permission
        android:name="${pluginApiAuthority}.permission.WRITE_SNIPPETS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_write_snippets_description"
        android:label="@string/permission_write_snippets" />
    <permission
        android:name="${pluginApiAuthority}.permission.READ_PLUGIN_LOG"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_read_plugin_log_description"
        android:label="@string/permission_read_plugin_log" />
    <permission
        android:name="${pluginApiAuthority}.permission.OPEN_SESSIONS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_open_sessions_description"
        android:label="@string/permission_open_sessions" />
    <permission
        android:name="${pluginApiAuthority}.permission.OPEN_SFTP_SESSIONS"
        android:permissionGroup="${pluginApiAuthority}.permission-group.PLUGIN_API"
        android:protectionLevel="dangerous"
        android:description="@string/permission_open_sftp_sessions_description"
        android:label="@string/permission_open_sftp_sessions" />

    <!--
      Provider-weite Vorgabe fuer jeden Pfad, den keine path-permission erfasst. Kein Plugin
      bekommt sie (signature), damit gilt: was keine Regel unten trifft, ist gesperrt. Ein
      Plugin mit passender path-permission kommt trotzdem durch — Android prueft die
      path-permission auch dann, wenn die Provider-Permission fehlt.
    -->
    <permission
        android:name="${pluginApiAuthority}.permission.PROVIDER_DEFAULT"
        android:protectionLevel="signature" />

    <application>
        <!--
          Nicht exportiert waere sinnlos: der Provider ist genau dafuer da, von anderen
          Apps gelesen zu werden. Der Zugriff haengt an den Permissions oben, jeder Pfad
          einzeln. Die path-permission-Regeln vergleichen den Pfad woertlich (`//connections`
          traefe keine), deshalb die Vorgabe PROVIDER_DEFAULT fuer den Rest und eine zweite
          Pruefung derselben Rechte in PluginProvider.
        -->
        <provider
            android:name="dev.jaui.squeezessh.pluginapi.PluginProvider"
            android:readPermission="${pluginApiAuthority}.permission.PROVIDER_DEFAULT"
            android:writePermission="${pluginApiAuthority}.permission.PROVIDER_DEFAULT"
            android:authorities="${pluginApiAuthority}"
            android:exported="true"
            android:grantUriPermissions="false">
            <path-permission
                android:path="/connections"
                android:readPermission="${pluginApiAuthority}.permission.READ_CONNECTIONS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_CONNECTIONS" />
            <path-permission
                android:pathPrefix="/connections/"
                android:readPermission="${pluginApiAuthority}.permission.READ_CONNECTIONS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_CONNECTIONS" />
            <path-permission
                android:path="/connectiongroups"
                android:readPermission="${pluginApiAuthority}.permission.READ_CONNECTION_GROUPS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_CONNECTION_GROUPS" />
            <path-permission
                android:pathPrefix="/connectiongroups/"
                android:readPermission="${pluginApiAuthority}.permission.READ_CONNECTION_GROUPS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_CONNECTION_GROUPS" />
            <path-permission
                android:path="/connectiongroupmemberships"
                android:readPermission="${pluginApiAuthority}.permission.READ_CONNECTION_GROUPS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_CONNECTION_GROUPS" />
            <path-permission
                android:path="/portforwards"
                android:readPermission="${pluginApiAuthority}.permission.READ_PORT_FORWARDS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_PORT_FORWARDS" />
            <path-permission
                android:pathPrefix="/portforwards/"
                android:readPermission="${pluginApiAuthority}.permission.READ_PORT_FORWARDS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_PORT_FORWARDS" />
            <path-permission
                android:path="/snippets"
                android:readPermission="${pluginApiAuthority}.permission.READ_SNIPPETS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_SNIPPETS" />
            <path-permission
                android:pathPrefix="/snippets/"
                android:readPermission="${pluginApiAuthority}.permission.READ_SNIPPETS"
                android:writePermission="${pluginApiAuthority}.permission.WRITE_SNIPPETS" />
            <!-- Der Pruefpfad ist nur lesbar; ein Schreibrecht gibt es dafuer nicht. -->
            <path-permission
                android:path="/pluginlog"
                android:readPermission="${pluginApiAuthority}.permission.READ_PLUGIN_LOG" />
        </provider>

        <!--
          Sitzungsaufbau fuer Plugins. Nicht exportiert: erreichbar nur ueber MainActivity,
          die als einziger Einstieg fuer `ssh://` dient. Zwei Aktivitaeten mit demselben
          Intent-Filter fuehren sonst zu einem Auswahldialog beim Plugin.
        -->
        <activity
            android:name="dev.jaui.squeezessh.pluginapi.PluginConnectActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SqueezeSsh" />

        <service
            android:name="dev.jaui.squeezessh.pluginapi.PluginService"
            android:exported="true"
            android:permission="${pluginApiAuthority}.permission.OPEN_SESSIONS">
            <intent-filter>
                <action android:name="${pluginApiPackage}.pluginservice" />
            </intent-filter>
        </service>

        <service
            android:name="dev.jaui.squeezessh.pluginapi.ConnectionPluginService"
            android:exported="true"
            android:permission="${pluginApiAuthority}.permission.OPEN_SESSIONS">
            <intent-filter>
                <action android:name="${pluginApiPackage}.connectionpluginservice" />
            </intent-filter>
        </service>

        <service
            android:name="dev.jaui.squeezessh.pluginapi.SftpPluginService"
            android:exported="true"
            android:permission="${pluginApiAuthority}.permission.OPEN_SFTP_SESSIONS">
            <intent-filter>
                <action android:name="${pluginApiPackage}.sftppluginservice" />
            </intent-filter>
        </service>
    </application>
</manifest>
