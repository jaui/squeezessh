Port 22
PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication yes

# Fuer die Jump-Host-Tests: der Bastion muss Verbindungen weiterreichen duerfen.
AllowTcpForwarding yes
GatewayPorts yes
PermitTunnel yes

Subsystem sftp /usr/lib/ssh/sftp-server

# Grosszuegig genug, dass ein Mensch in Ruhe einen Fingerprint vergleichen kann — sonst
# stirbt die Verbindung ausgerechnet dann, wenn jemand sorgfaeltig ist.
LoginGraceTime 120
ClientAliveInterval 30
ClientAliveCountMax 6

# OpenSSH 9.8 sperrt nach fehlgeschlagenen oder abgebrochenen Versuchen minutenlang die
# Quell-IP. In einer Testumgebung heisst das: ein absichtlich fehlerhafter Test macht die
# darauffolgenden kaputt. Hier deshalb aus.
PerSourcePenalties no

LogLevel VERBOSE
